.program dshot
.side_set 1

.wrap_target
    set pindirs, 1      side 1
    set y, 16     side 1
    txloop:
        jmp !y dorx      side 1
        out x, 1     side 1
        jmp !x dozero     side 0 [2]
    doone:
        nop     side 0 [3]
        jmp y-- txloop     side 1
    dozero:
        jmp y-- txloop    side 1 [4]

    dorx:
        set pindirs, 0      side 0 [15]
        nop     side 0 [15]
        nop     side 0 [15]
        nop     side 0 [15]
        nop     side 0 [15]
        nop     side 0 [15]
        nop     side 0 [8]
        set y, 19       side 0
    rxloop:
        in pins, 1      side 0
        jmp y-- rxloop      side 0 [6]
    push noblock        side 0
.wrap

% c-sdk {
    #include "hardware/clocks.h"

    void dshot_program_init(PIO pio, uint sm, uint offset, uint pins) {
        pio_gpio_init(pio, pins);
        gpio_set_pulls(pins, true, false);

        pio_sm_config c = dshot_program_get_default_config(offset);

        sm_config_set_sideset_pins(&c, pins);
        sm_config_set_set_pins(&c, pins, 1);
        sm_config_set_out_shift(&c, false, true, 16);
        sm_config_set_in_pins(&c, pins);
        sm_config_set_in_shift(&c, false, false, 20);

        float div = clock_get_hz(clk_sys) / (3000000);
        sm_config_set_clkdiv(&c, div);

        pio_sm_init(pio, sm, offset, &c);
        pio_sm_set_enabled(pio, sm, true);
    }
%}