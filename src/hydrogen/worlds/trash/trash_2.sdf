<?xml version="1.0"?>
<sdf version="1.9">
  <model name="trash">
    <static>true</static>


    <!--Ladle-->
    <link name="ladle_link">
        <pose>0 0.02 -1.37 0 0 0</pose>
        <collision name="ladle_collision">
            <geometry>
                <mesh>
                    <uri>model://trash/ladle.stl</uri>
                    <scale>0.003 0.003 0.003</scale>
                </mesh>
            </geometry>
        </collision>

        <visual name="ladle_visual">
            <geometry>
                <mesh>
                    <uri>model://trash/ladle.stl</uri>
                    <scale>0.003 0.003 0.003</scale>
                </mesh>
            </geometry>
            <material>
                <ambient>0 1 0 1</ambient> 
                <diffuse>0 1 0 1</diffuse>
            </material>
        </visual>
    </link>

    <!--Leftmost Ladle-->
    <link name="ladle_link_2">
        <pose>0 0.12 -1.37 0 0 0</pose>
        <collision name="ladle_collision_2">
            <geometry>
                <mesh>
                    <uri>model://trash/ladle.stl</uri>
                    <scale>0.003 0.003 0.003</scale>
                </mesh>
            </geometry>
        </collision>

        <visual name="ladle_visual_2">
