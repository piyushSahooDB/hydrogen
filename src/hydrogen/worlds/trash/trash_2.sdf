                </mesh>
            </geometry>
            <material>
                <ambient>0 1 0 1</ambient> 
                <diffuse>0 1 0 1</diffuse>
            </material>
        </visual>
    </link>


    <!--Left Bottle-->
    <link name="bottle_link">
        <pose>0.2 0.0 -1.56 0 0 0</pose>

        <collision name="bottle_collision">
            <geometry>
                <mesh>
                    <uri>model://trash/bottle.stl</uri>
                    <scale>0.005 0.005 0.005</scale>
                </mesh>
            </geometry>
        </collision>

        <visual name="bottle_visual">
            <geometry>
                <mesh>
                    <uri>model://trash/bottle.stl</uri>
                    <scale>0.005 0.005 0.005</scale>
                </mesh>
            </geometry>
            <material>
                <ambient>1 0 0 1</ambient> 
                <diffuse>1 0 0 1</diffuse>
            </material>
        </visual>

    </link>



    <!--Middle Bottle-->
    <link name="bottle_link_2">
        <pose>0.2 -0.1 -1.56 0 0 0</pose>

        <collision name="bottle_collision_2">
            <geometry>
                <mesh>
                    <uri>model://trash/bottle.stl</uri>
                    <scale>0.005 0.005 0.005</scale>
