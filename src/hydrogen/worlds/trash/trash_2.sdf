                <mesh>
                    <uri>model://trash/ladle.stl</uri>
                    <scale>0.003 0.003 0.003</scale>
                </mesh>
            </geometry>
            <material>
                <ambient>0 1 0 1</ambient> 
                <diffuse>0 1 0 1</diffuse>
            </material>
        </visual>
    </link>
    
    <!--Right Ladle-->
